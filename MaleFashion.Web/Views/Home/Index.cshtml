@model IEnumerable<MaleFashion.Web.Models.Product>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section Begin -->
<section class="hero">
    <div class="hero__slider owl-carousel">
        <div class="hero__items set-bg" data-setbg="/img/hero/hero-1.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-5 col-lg-7 col-md-8">
                        <div class="hero__text">
                            <h6>Smash Collection</h6>
                            <h2>Fall - Winter Collections 2025</h2>
                            <p>A specialist label creating luxury essentials. Ethically crafted with an unwavering
                            commitment to exceptional quality.</p>
                            <a href="@Url.Action("Index", "Shop")" class="primary-btn">Shop now <span class="arrow_right"></span></a>
                            <div class="hero__social">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero__items set-bg" data-setbg="/img/hero/hero-2.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-xl-5 col-lg-7 col-md-8">
                        <div class="hero__text">
                            <h6>Smash Collection</h6>
                            <h2>Fall - Winter Collections 2025</h2>
                            <p>A specialist label creating luxury essentials. Ethically crafted with an unwavering
                            commitment to exceptional quality.</p>
                            <a href="@Url.Action("Index", "Shop")" class="primary-btn">Shop now <span class="arrow_right"></span></a>
                            <div class="hero__social">
                                <a href="#"><i class="fa fa-facebook"></i></a>
                                <a href="#"><i class="fa fa-twitter"></i></a>
                                <a href="#"><i class="fa fa-pinterest"></i></a>
                                <a href="#"><i class="fa fa-instagram"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->

<!-- Banner Section Begin -->
<section class="banner spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-7 offset-lg-4">
                <div class="banner__item">
                    <div class="banner__item__pic">
                        <img src="~/img/banner/banner-1.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Clothing Collections 2025</h2>
                        <a href="@Url.Action("Index", "Shop")">Shop now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="banner__item banner__item--middle">
                    <div class="banner__item__pic">
                        <img src="~/img/banner/banner-2.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Accessories</h2>
                        <a href="@Url.Action("Index", "Shop")">Shop now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="banner__item banner__item--last">
                    <div class="banner__item__pic">
                        <img src="~/img/banner/banner-3.jpg" alt="">
                    </div>
                    <div class="banner__item__text">
                        <h2>Shoes Spring 2025</h2>
                        <a href="@Url.Action("Index", "Shop")">Shop now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Banner Section End -->

<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <ul class="filter__controls">
                    <li class="active" data-filter="*">Best Sellers</li>
                    <li data-filter=".new-arrivals">New Arrivals</li>
                    <li data-filter=".hot-sales">Hot Sales</li>
                </ul>
            </div>
        </div>
        <div class="row product__filter">
            @foreach (var item in Model)
            {
                var mixClass = "";
                if (item.Label == "New") { mixClass = "new-arrivals"; }
                else if (item.Label == "Sale") { mixClass = "hot-sales"; }
                
                <div class="col-lg-3 col-md-6 col-sm-6 col-md-6 col-sm-6 mix @mixClass">
                    <div class="product__item @(item.Label == "Sale" ? "sale" : "")">
                        <div class="product__item__pic set-bg" data-setbg="@(item.ImageUrl?.StartsWith("http") == true || item.ImageUrl?.StartsWith("data:") == true ? item.ImageUrl : Url.Content("~" + (item.ImageUrl?.StartsWith("/") == true ? "" : "/") + item.ImageUrl))" ondblclick="window.location.href='@Url.Action("Details", "Shop", new { id = item.Id })'" style="cursor: pointer;">
                            @if (!string.IsNullOrEmpty(item.Label))
                            {
                                <span class="label">@item.Label</span>
                            }
                            <ul class="product__hover">
                                <li><a href="@Url.Action("AddToWishlist", "Wishlist", new { id = item.Id })" class="ajax-wishlist"><i class="fa fa-heart-o"></i><span>Wishlist</span></a></li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6>@item.Name</h6>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="ajax-cart-form" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="add-cart" style="border:none; background:none; cursor:pointer;">+ Add To Cart</button>
                            </form>
                            <div class="rating">
                                @for (int i = 0; i < item.Rating; i++)
                                {
                                    <i class="fa fa-star"></i>
                                }
                                @for (int i = item.Rating; i < 5; i++)
                                {
                                    <i class="fa fa-star-o"></i>
                                }
                            </div>
                            <h5>₹@item.Price</h5>
                            <div class="product__color__select">
                                <label for="pc-1-@item.Id">
                                    <input type="radio" id="pc-1-@item.Id">
                                </label>
                                <label class="active black" for="pc-2-@item.Id">
                                    <input type="radio" id="pc-2-@item.Id">
                                </label>
                                <label class="grey" for="pc-3-@item.Id">
                                    <input type="radio" id="pc-3-@item.Id">
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Product Section End -->

<!-- Instagram Section Begin -->
<section class="instagram spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="instagram__pic">
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-1.jpg"></div>
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-2.jpg"></div>
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-3.jpg"></div>
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-4.jpg"></div>
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-5.jpg"></div>
                    <div class="instagram__pic__item set-bg" data-setbg="/img/product/product-6.jpg"></div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="instagram__text">
                    <h2>Instagram</h2>
                    <p>Follow us on Instagram for the latest collection drops, style inspiration, and exclusive behind-the-scenes content from Smash Collections Panruti.</p>
                    <h3>#smashcollectionspanruti</h3>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Instagram Section End -->

<!-- Latest Blog Section Begin -->
<section class="latest spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Latest News</span>
                    <h2>Fashion New Trends</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6 col-sm-6">
                <div class="blog__item">
                    <div class="blog__item__pic set-bg" data-setbg="/img/blog/blog-1.jpg"></div>
                    <div class="blog__item__text">
                        <span><img src="/img/icon/calendar.png" alt=""> 16 February 2020</span>
                        <h5>What Curling Irons Are The Best Ones</h5>
                        <a href="#">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 col-sm-6">
                <div class="blog__item">
                    <div class="blog__item__pic set-bg" data-setbg="/img/blog/blog-2.jpg"></div>
                    <div class="blog__item__text">
                        <span><img src="/img/icon/calendar.png" alt=""> 21 February 2020</span>
                        <h5>Eternity Bands Do Last Forever</h5>
                        <a href="#">Read More</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 col-sm-6">
                <div class="blog__item">
                    <div class="blog__item__pic set-bg" data-setbg="/img/blog/blog-3.jpg"></div>
                    <div class="blog__item__text">
                        <span><img src="/img/icon/calendar.png" alt=""> 28 February 2020</span>
                        <h5>The Health Benefits Of Sunglasses</h5>
                        <a href="#">Read More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Latest Blog Section End -->

<script>
    // Fix for background images set via data-setbg
    window.onload = function() {
        $('.set-bg').each(function () {
            var bg = $(this).data('setbg');
            // Check if it's already a full path or needs ~/ (actually JS runs on client so it needs /img/...)
            // The template JS usually processes this. 
            // However, seeing as the template JS uses data-setbg, we should ensure the paths in data-setbg are correct.
            // In ASP.NET, 'img/...' might need to be resolved if we are in a sub-path, but typically for root it's fine.
            // Let's assume the template's main.js handles it using CSS background-image.
            // But we need to make sure the paths in HTML are relative to webroot.
            // In Razor, data-setbg="img/..." will be output as-is.
            // If we are at /Home/Index, 'img/...' might be looked for at /Home/img/... which is wrong.
            // It should be '/img/...'.
            // So I should update all data-setbg="img/..." to data-setbg="/img/..." in this file.
        });
    };
</script>
