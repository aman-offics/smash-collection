@model IEnumerable<MaleFashion.Web.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Manage Products</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <a href="/Admin">Admin</a>
                        <span>Products</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="admin-users spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="admin-sidebar">
                    <ul class="list-group">
                        <li class="list-group-item"><a href="/Admin/Index" class="text-dark">Dashboard</a></li>
                        <li class="list-group-item"><a href="/Admin/Users" class="text-dark">Manage Users</a></li>
                        <li class="list-group-item active"><a href="/Admin/Products" class="text-white">Manage Products</a></li>
                        <li class="list-group-item"><a href="/Admin/Messages" class="text-dark">Messages</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="mb-3 text-right">
                    <a href="/Admin/AddProduct" class="site-btn">Add New Product</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Image</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr id="product-row-@product.Id">
                                    <td><img src="@product.ImageUrl" style="width:50px;height:50px;object-fit:cover;" /></td>
                                    <td>@product.Name</td>
                                    <td>@product.Category</td>
                                    <td>₹@product.Price</td>
                                    <td>
                                        <a href="/Admin/EditProduct/@product.Id" class="btn btn-sm btn-primary">Edit</a>
                                        <button class="btn btn-sm btn-danger delete-product-btn" data-id="@product.Id">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.delete-product-btn').click(function () {
                if (confirm('Are you sure you want to delete this product?')) {
                    var btn = $(this);
                    var productId = btn.data('id');

                    $.ajax({
                        url: '/Admin/DeleteProduct',
                        type: 'POST',
                        data: { id: productId },
                        success: function (response) {
                            if (response.success) {
                                $('#product-row-' + productId).fadeOut(300, function() { $(this).remove(); });
                                showToast(response.message, false);
                            } else {
                                showToast(response.message, true);
                            }
                        },
                        error: function () {
                            showToast("An error occurred.", true);
                        }
                    });
                }
            });
        });
    </script>
}
