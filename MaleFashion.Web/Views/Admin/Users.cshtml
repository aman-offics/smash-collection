@model IEnumerable<MaleFashion.Web.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Manage Users</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <a href="/Admin">Admin</a>
                        <span>Users</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<section class="admin-users spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="admin-sidebar">
                    <ul class="list-group">
                        <li class="list-group-item"><a href="/Admin/Index" class="text-dark">Dashboard</a></li>
                        <li class="list-group-item active"><a href="/Admin/Users" class="text-white">Manage Users</a></li>
                        <li class="list-group-item"><a href="/Admin/Products" class="text-dark">Manage Products</a></li>
                        <li class="list-group-item"><a href="/Admin/Messages" class="text-dark">Messages</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Username</td>
                                    <td>@user.Email</td>
                                    <td>@(user.IsAdmin ? "Admin" : "User")</td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "badge-success" : "badge-danger")" id="status-badge-@user.Id">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/Admin/EditUser/@user.Id" class="btn btn-sm btn-primary">Edit</a>
                                        @if (user.Username.ToLower() != "admin")
                                        {
                                            <button class="btn btn-sm @(user.IsActive ? "btn-danger" : "btn-success") toggle-user-btn" data-id="@user.Id">
                                                @(user.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-user-btn').click(function () {
                var btn = $(this);
                var userId = btn.data('id');

                $.ajax({
                    url: '/Admin/ToggleUserStatus',
                    type: 'POST',
                    data: { id: userId },
                    success: function (response) {
                        if (response.success) {
                            var badge = $('#status-badge-' + userId);
                            if (response.isActive) {
                                badge.removeClass('badge-danger').addClass('badge-success').text('Active');
                                btn.removeClass('btn-success').addClass('btn-danger').text('Deactivate');
                            } else {
                                badge.removeClass('badge-success').addClass('badge-danger').text('Inactive');
                                btn.removeClass('btn-danger').addClass('btn-success').text('Activate');
                            }
                            showToast(response.message, false);
                        } else {
                            showToast(response.message, true);
                        }
                    },
                    error: function () {
                        showToast("An error occurred.", true);
                    }
                });
            });
        });
    </script>
}
