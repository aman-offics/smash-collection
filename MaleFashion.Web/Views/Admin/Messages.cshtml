@model IEnumerable<MaleFashion.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Messages";
}

<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Messages</h4>
                    <div class="breadcrumb__links">
                        <a href="/">Home</a>
                        <a href="/Admin">Admin</a>
                        <span>Messages</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="admin-users spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="admin-sidebar">
                    <ul class="list-group">
                        <li class="list-group-item"><a href="/Admin/Index" class="text-dark">Dashboard</a></li>
                        <li class="list-group-item"><a href="/Admin/Users" class="text-dark">Manage Users</a></li>
                        <li class="list-group-item"><a href="/Admin/Products" class="text-dark">Manage Products</a></li>
                        <li class="list-group-item active"><a href="/Admin/Messages" class="text-white">Messages</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Date</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center">No messages received yet.</td>
                                </tr>
                            }
                            @foreach (var msg in Model)
                            {
                                <tr>
                                    <td style="white-space: nowrap;">@msg.SentAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>@msg.Name</td>
                                    <td><a href="mailto:@msg.Email">@msg.Email</a></td>
                                    <td>@msg.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
