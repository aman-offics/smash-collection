@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using MaleFashion.Web.Models
@inject IHttpContextAccessor HttpContextAccessor
@inject MaleFashion.Web.Data.AppDbContext DbContext
<html lang="zxx">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="Male_Fashion Template">
    <meta name="keywords" content="Male_Fashion, unica, creative, html">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Smash Collections | @ViewData["Title"]</title>

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700;800;900&display=swap"
    rel="stylesheet">

    <!-- Css Styles -->
    <link rel="stylesheet" href="~/css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="~/css/magnific-popup.css" type="text/css">
    <link rel="stylesheet" href="~/css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/slicknav.min.css" type="text/css">
    <link rel="stylesheet" href="~/css/style.css" type="text/css">
    <link rel="stylesheet" href="~/css/dark-mode.css" type="text/css">
    <style>
        .wishlist-badge, .cart-badge {
            background: #e53637 !important; /* Original Red */
            color: #000000 !important;
            height: 18px;
            width: 18px;
            border-radius: 50%;
            display: inline-block;
            text-align: center;
            line-height: 18px;
            font-size: 11px;
            font-weight: 700;
            position: absolute;
            top: -8px;
            right: -12px;
        }
        .header__nav__option a, .offcanvas__nav__option a {
            position: relative;
        }
        
        .heart-active i {
            color: #FF007F !important; /* Rose Color */
        }
        .heart-active img {
            filter: invert(14%) sepia(93%) saturate(7463%) hue-rotate(327deg) brightness(97%) contrast(108%) !important;
        }
        .footer__logo img {
            filter: invert(1);
        }
        .nav-extra-dropdown .dropdown-content {
            z-index: 999;
        }
        .nav-extra-dropdown .dropdown-content::before {
            content: '';
            position: absolute;
            top: -20px;
            left: 0;
            width: 100%;
            height: 20px;
            background: transparent;
            }

        git add .
    </style>
</head>

<body>
    @{
        var sessionUsername = HttpContextAccessor.HttpContext.Session.GetString("Username");
        var cartCount = 0;
        var wishlistCount = 0;
        bool isAdmin = false;

        if (sessionUsername != null)
        {
            var user = DbContext.Users.FirstOrDefault(u => u.Username.ToLower() == sessionUsername.ToLower());
            if (user != null)
            {
                isAdmin = user.IsAdmin;
                cartCount = DbContext.CartItems.Where(c => c.UserId == user.Id).Sum(c => c.Quantity);
                wishlistCount = DbContext.WishlistItems.Count(w => w.UserId == user.Id);
            }
        }
    }
    <!-- Page Preloder -->
    <div id="preloder">
        <div class="loader"></div>
    </div>

    <!-- Offcanvas Menu Begin -->
    <div class="offcanvas-menu-overlay"></div>
    <div class="offcanvas-menu-wrapper">
        <div class="offcanvas__option">
            <div class="offcanvas__links">
                @{
                    if (sessionUsername != null)
                    {
                        <a href="@Url.Action("Profile", "Account")">Hi, @sessionUsername</a>
                        <a href="@Url.Action("Logout", "Account")">Sign Out</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account")">Sign in</a>
                        <a href="@Url.Action("Register", "Account")">Sign up</a>
                    }
                }
                <a href="#">FAQs</a>
            </div>
            <div class="offcanvas__top__hover">
                <span>Inr <i class="arrow_carrot-down"></i></span>
                <ul>
                    <li>INR</li>
                    <li>USD</li>
                    <li>EUR</li>
                </ul>
            </div>
        </div>
        <div class="offcanvas__nav__option">
            <a href="#" class="search-switch"><img src="~/img/icon/search.png" alt=""></a>
            <a href="@Url.Action("Index", "Wishlist")"><img src="~/img/icon/heart.png" alt=""> <span class="wishlist-badge">@wishlistCount</span></a>
            <a href="@Url.Action("Index", "Cart")"><img src="~/img/icon/cart.png" alt=""> <span class="cart-badge">@cartCount</span></a>
        </div>
        <div id="mobile-menu-wrap"></div>
        <div class="offcanvas__text">
            <p>Free shipping, 30-day return or refund guarantee.</p>
        </div>
    </div>
    <!-- Offcanvas Menu End -->

    <!-- Header Section Begin -->
    <header class="header">

        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-3 col-md-3">
                    <div class="header__logo" style="display: flex; align-items: center;">
                        <a href="@Url.Action("Index", "Home")" style="display: flex; align-items: center; text-decoration: none;">
                            <img src="~/img/ssss.png" alt="Smash" style="height: 36px; width: auto; margin-right: 12px; object-fit: contain;">
                            <img src="~/img/smash_logo_black.png" alt="Smash" style="height: 28px; width: auto; object-fit: contain;">
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <nav class="header__menu mobile-menu">
                        <ul>
                            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"><a href="@Url.Action("Index", "Home")">Home</a></li>
                            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Shop" ? "active" : "")"><a href="@Url.Action("Index", "Shop")">Shop</a></li>
                            <li><a href="#">Pages</a>
                                <ul class="dropdown">
                                    <li><a href="@Url.Action("About", "Home")">About Us</a></li>
                                    <li><a href="@Url.Action("Details", "Shop")">Shop Details</a></li>
                                    <li><a href="@Url.Action("Index", "Cart")">Shopping Cart</a></li>
                                    <li><a href="@Url.Action("Index", "Checkout")">Check Out</a></li>
                                    <li><a href="@Url.Action("Details", "Blog")">Blog Details</a></li>
                                </ul>
                            </li>
                            <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Blog" ? "active" : "")"><a href="@Url.Action("Index", "Blog")">Blog</a></li>
                            <li class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Contact" ? "active" : "")"><a href="@Url.Action("Contact", "Home")">Contacts</a></li>
                        </ul>
                    </nav>
                </div>
                <div class="col-lg-3 col-md-3">
                    <div class="header__nav__option">
                        <a href="#" class="search-switch"><img src="~/img/icon/search.png" alt=""></a>
                        <a href="@Url.Action("Index", "Wishlist")"><img src="~/img/icon/heart.png" alt=""> <span class="wishlist-badge">@wishlistCount</span></a>
                        <a href="@Url.Action("Index", "Cart")"><img src="~/img/icon/cart.png" alt=""> <span class="cart-badge">@cartCount</span></a>
                        <div class="nav-extra-dropdown" style="display: inline-block; position: relative; margin-left: 20px; cursor: pointer; vertical-align: middle;">
                            <i class="fa fa-user-circle-o header-user-icon" style="font-size: 22px;"></i>
                            <ul class="dropdown-content">
                                @{
                                    if (sessionUsername != null)
                                    {
                                        <li><span class="dropdown-greeting" style="display: block; padding: 10px 20px; font-weight: 700; border-bottom: 1px solid #e5e5e5; margin-bottom: 5px;">Hi, @sessionUsername</span></li>
                                        if (isAdmin)
                                        {
                                            <li><a href="@Url.Action("Index", "Admin")">Admin Dashboard</a></li>
                                        }
                                        <li><a href="@Url.Action("Profile", "Account")">My Profile</a></li>
                                        <li><a href="@Url.Action("Logout", "Account")">Sign Out</a></li>
                                    }
                                    else
                                    {
                                        <li><a href="@Url.Action("Login", "Account")">Sign In</a></li>
                                        <li><a href="@Url.Action("Register", "Account")">Sign Up</a></li>
                                    }
                                }
                            </ul>
                        </div>
                        <div class="theme-switch-wrapper" style="vertical-align: middle;">
                            <label class="theme-switch" for="checkbox">
                                <input type="checkbox" id="checkbox" />
                                <div class="slider round"></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="canvas__open"><i class="fa fa-bars"></i></div>
        </div>
    </header>
    <!-- Header Section End -->

    <div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 10000;"></div>

    @RenderBody()

    <!-- Footer Section Begin -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="footer__about">
                        <div class="footer__logo">
                            <a href="#"><img src="~/img/wwwww.png" alt=""></a>
                        </div>
                        <p>The customer is at the heart of our unique business model, which includes design.</p>
                        <a href="#"><img src="~/img/payment.png" alt=""></a>
                    </div>
                </div>
                <div class="col-lg-2 offset-lg-1 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Shopping</h6>
                        <ul>
                            <li><a href="@Url.Action("Index", "Shop")">Clothing Store</a></li>
                            <li><a href="@Url.Action("Index", "Shop")">Trending Shoes</a></li>
                            <li><a href="@Url.Action("Index", "Shop")">Accessories</a></li>
                            <li><a href="@Url.Action("Index", "Shop")">Sale</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Shopping</h6>
                        <ul>
                            <li><a href="@Url.Action("Contact", "Home")">Contact Us</a></li>
                            <li><a href="#">Payment Methods</a></li>
                            <li><a href="#">Delivary</a></li>
                            <li><a href="#">Return & Exchanges</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3 offset-lg-1 col-md-6 col-sm-6">
                    <div class="footer__widget">
                        <h6>NewLetter</h6>
                        <div class="footer__newslatter">
                            <p>Be the first to know about new arrivals, look books, sales & promos!</p>
                            <form action="#">
                                <input type="text" placeholder="Your email">
                                <button type="submit"><span class="icon_mail_alt"></span></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="footer__copyright__text">
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                        <p>Copyright ©
                        2025
                            All rights reserved | by Smash collections
                        </p>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- Footer Section End -->

    <!-- Search Begin -->
    <div class="search-model">
        <div class="h-100 d-flex align-items-center justify-content-center">
            <div class="search-close-switch">+</div>
            <form action="@Url.Action("Index", "Shop")" method="get" class="search-model-form">
                <input type="text" id="search-input" name="search" placeholder="Search here.....">
            </form>
        </div>
    </div>
    <!-- Search End -->

    <!-- Toast Container -->
    <div id="toast-container"></div>

    <!-- Js Plugins -->
    <script src="~/js/jquery-3.3.1.min.js"></script>

    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.nice-select.min.js"></script>
    <script src="~/js/jquery.nicescroll.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/jquery.countdown.min.js"></script>
    <script src="~/js/jquery.slicknav.js"></script>
    <script src="~/js/mixitup.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Toast Notification Function (Global)
        function showToast(message, type = 'success') {
            $('#toast-container').empty(); // One popup is enough
            let iconClass = 'fa-check-circle';
            let iconColor = '#a4e61d';
            
            if (message.toLowerCase().includes('already')) {
                iconClass = 'fa-exclamation-circle';
                iconColor = '#ffc107'; // Warning yellow
            } else if (message.toLowerCase().includes('sign in') || type === 'error') {
                iconClass = 'fa-exclamation-circle';
                iconColor = '#e53637'; // Red warning
            }
            
            const icon = '<i class="fa ' + iconClass + '" style="color: ' + iconColor + '; margin-right: 12px; font-size: 20px; vertical-align: middle;"></i>';
            const toast = $('<div class="toast-item ' + type + '">' + icon + '<span style="vertical-align: middle;">' + message + '</span></div>');
            $('#toast-container').append(toast);
            setTimeout(() => {
                toast.addClass('show');
            }, 100);
            setTimeout(() => {
                toast.removeClass('show');
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }

        $(document).ready(function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                showToast('@TempData["SuccessMessage"]', 'success');
                </text>
            }

            // AJAX Add to Cart
            $(document).on('submit', '.ajax-cart-form', function (e) {
                e.preventDefault();
                const form = $(this);
                const url = form.attr('action');
                const data = form.serialize();

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: data,
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        if (response.success) {
                            $('.cart-badge').text(response.count);
                            showToast(response.message);
                        } else if (response.needsLogin) {
                            showToast(response.message, 'error');
                        }
                    }
                });
            });

            // AJAX Add to Wishlist
            $(document).on('click', '.ajax-wishlist', function (e) {
                e.preventDefault();
                const link = $(this);
                const url = link.attr('href');

                $.ajax({
                    url: url,
                    type: 'GET',
                    headers: { "X-Requested-With": "XMLHttpRequest" },
                    success: function (response) {
                        if (response.success) {
                            $('.wishlist-badge').text(response.count);
                            showToast(response.message);
                            if (response.added) {
                                link.find('i').removeClass('fa-heart-o').addClass('fa-heart').css('color', '#FF007F');
                            }
                        } else if (response.needsLogin) {
                            showToast(response.message, 'error');
                        }
                    }
                });
            });
            // Dark Mode Toggle
            const toggleSwitch = document.querySelector('.theme-switch input[type="checkbox"]');
            const currentTheme = localStorage.getItem('theme') ? localStorage.getItem('theme') : null;

            if (currentTheme) {
                document.documentElement.setAttribute('data-theme', currentTheme);

                if (currentTheme === 'dark') {
                    toggleSwitch.checked = true;
                }
            }

            toggleSwitch.addEventListener('change', function(e) {
                if (e.target.checked) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                }    
            }, false);
        });
    </script>
</body>

</html>
